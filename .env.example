# Environment Variables Configuration
# Copy this file to .env and fill in your credentials for deployment

# GitHub Token for automated GitHub Pages updates (optional)
GITHUB_TOKEN=

# -----------------------------------------------------------------
# OPTION A: SUPABASE CONFIGURATION (Recommended)
# -----------------------------------------------------------------
# Supabase Project URL (e.g., https://xyz.supabase.co)
VITE_SUPABASE_URL=
# Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY=

# Server-side environment variables (if running Node express server)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------
# OPTION B: FIREBASE CONFIGURATION
# -----------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

